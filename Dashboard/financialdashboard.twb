      <column caption='Average_Return' datatype='real' name='[Calculation_0611120232415232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Pivot Field Values])' />
      </column>
      <column caption='volatility' datatype='real' name='[Calculation_0611120232779777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Pivot Field Values])' />
      </column>
      <column caption='Annual return' datatype='real' name='[Calculation_1201559384633344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1+AVG([Pivot Field Values]))^252-1' />
      </column>
      <column caption='annual volatility' datatype='real' name='[Calculation_1201559385247745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Pivot Field Values])*SQRT(252)' />
      </column>
      <column caption='sharpratio' datatype='real' name='[Calculation_1201559385534466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1201559384633344]-0.02)/[Calculation_1201559385247745]' />
